# ── Frontend (React) ──────────────────────────────────────
REACT_APP_API_URL=http://localhost:5003

# ── Backend (Express, backend/ 에서 로드) ─────────────────
# nf_main 상품 마스터 조회 (읽기 전용, 롤 r_matching). 자격증명 하드코딩 금지.
# 접속 우선순위: (1) DATABASE_URL → (2) Cloud SQL 소켓 → (3) PG*
#
# (1) 로컬/유연:
DATABASE_URL=postgres://r_matching:<password>@<host>:5432/nf_main
#
# (2) 프로덕션(Cloud Run) — 형제앱 관례. Cloud SQL 유닉스 소켓.
#     비번은 Secret Manager(nf-db-role-matching) 주입. DATABASE_URL 은 비워둘 것.
# DB_USER=r_matching
# DB_PASSWORD=<from Secret Manager nf-db-role-matching>
# CLOUD_SQL_INSTANCE=blackyak-493519:asia-northeast3:nf-db
# CLOUD_SQL_DATABASE=nf_main
#
# (3) PG* 개별: PGHOST= PGUSER= PGPASSWORD= PGDATABASE= PGPORT=

# Google Sheets 서비스계정 (프로덕션). 로컬은 backend/config/Google Sheets API.json
# GOOGLE_CREDENTIALS_JSON={...}

# 주문 시트/탭 이름 (기본값 상품매칭용시트 / 시트1)
# SPREADSHEET_NAME=상품매칭용시트
# ORDER_SHEET_NAME=시트1
